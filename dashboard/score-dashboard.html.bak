<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>부서 대시보드 - S-CORE</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
    <style>
        body { background: #f5f7fa; font-family: 'Pretendard', -apple-system, sans-serif; }
        .container-main { max-width: 1400px; margin: 0 auto; padding: 1.5rem; }
        .header { background: linear-gradient(135deg, #1a365d 0%, #2c5282 50%, #2b6cb0 100%); color: white; padding: 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); margin-bottom: 1.5rem; }
        .card-header { background: #2c5282; color: white; font-weight: 600; border-radius: 12px 12px 0 0 !important; padding: 1rem 1.5rem; }
        .stat-card { background: white; border-radius: 12px; padding: 1.5rem; text-align: center; box-shadow: 0 2px 12px rgba(0,0,0,0.08); height: 100%; }
        .stat-card .value { font-size: 2.5rem; font-weight: 700; color: #2c5282; }
        .stat-card .label { font-size: 0.9rem; color: #718096; margin-top: 0.5rem; }
        .stat-card .icon { font-size: 2rem; color: #2b6cb0; margin-bottom: 0.5rem; }
        .rank-badge { display: inline-block; width: 28px; height: 28px; line-height: 28px; text-align: center; border-radius: 50%; font-weight: 700; font-size: 0.85rem; }
        .rank-1 { background: #ffd700; color: #333; }
        .rank-2 { background: #c0c0c0; color: #333; }
        .rank-3 { background: #cd7f32; color: white; }
        .rank-other { background: #e9ecef; color: #666; }
        .chart-container { position: relative; height: 300px; }
        .nav-menu { background: white; border-radius: 12px; padding: 1rem; margin-bottom: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
        .nav-menu a { color: #2c5282; text-decoration: none; padding: 0.5rem 1rem; border-radius: 8px; margin-right: 0.5rem; transition: all 0.2s; }
        .nav-menu a:hover, .nav-menu a.active { background: #2c5282; color: white; }
        .btn-outline-light:hover { background: rgba(255,255,255,0.15); }
    </style>
</head>
<body>
<div class="container-main">

<!-- 헤더 -->
<div class="header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 style="font-size:1.8rem; margin-bottom:0.25rem;"><i class="bi bi-bar-chart-fill me-2"></i>S-CORE</h1>
            <div style="opacity:0.9;">기자 지면 기여도 평가 시스템</div>
        </div>
        <div class="text-end">
            <small id="userInfo" class="me-2"></small>
            <button class="btn btn-sm btn-outline-light" onclick="logout()"><i class="bi bi-box-arrow-right"></i> 로그아웃</button>
        </div>
    </div>
</div>

<!-- 네비게이션 -->
<div class="nav-menu" id="navMenu">
    <a href="home.html" id="nav-home"><i class="bi bi-house-door me-1"></i>대시보드</a>
    <a href="score-dashboard.html" class="active"><i class="bi bi-speedometer2 me-1"></i>부서 대시보드</a>
    <a href="list.html"><i class="bi bi-people me-1"></i>기자 목록</a>
    <a href="score-eval.html"><i class="bi bi-clipboard-check me-1"></i>기사 평가</a>
    <a href="score-appeals.html"><i class="bi bi-chat-left-text me-1"></i>소명 관리</a>
    <a href="score-config.html" id="nav-config"><i class="bi bi-sliders me-1"></i>가중치 설정</a>
    <a href="admin.html" id="nav-admin"><i class="bi bi-gear me-1"></i>사원 관리</a>
</div>

<!-- 부서 선택 (admin용) -->
<div class="card mb-4" id="deptSelectCard" style="display:none;">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3">
            <label class="fw-bold text-nowrap">부서 선택</label>
            <select class="form-select" id="deptSelect" style="width:200px;" onchange="changeDept()">
                <option value="">전체 부서</option>
            </select>
        </div>
    </div>
</div>

<!-- 요약 통계 -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon"><i class="bi bi-newspaper"></i></div>
            <div class="value" id="totalArticles">-</div>
            <div class="label">총 기사 수</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon"><i class="bi bi-people-fill"></i></div>
            <div class="value" id="totalReporters">-</div>
            <div class="label">부서 기자 수</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon"><i class="bi bi-file-text"></i></div>
            <div class="value" id="avgChars">-</div>
            <div class="label">평균 글자수</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon"><i class="bi bi-trophy"></i></div>
            <div class="value" id="totalScore">-</div>
            <div class="label">부서 총점</div>
        </div>
    </div>
</div>

<div class="row">
    <!-- 기자 순위 TOP 10 -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-trophy me-2"></i>부서 기사수 TOP 10</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th style="width:15%">순위</th><th>기자명</th><th style="width:20%">기사수</th><th style="width:25%">총점</th></tr>
                    </thead>
                    <tbody id="topReporters"></tbody>
                </table>
            </div>
        </div>
    </div>
    
    <!-- 일별 증감 -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-arrow-down-up me-2"></i>최근 일별 기사수</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>날짜</th><th style="width:25%">기사수</th><th style="width:30%">전일 대비</th></tr>
                    </thead>
                    <tbody id="dailyChange"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- 일별 기사수 추이 -->
    <div class="col-12">
        <div class="card">
            <div class="card-header"><i class="bi bi-graph-up me-2"></i>일별 기사수 추이</div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="dailyChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="score.js"></script>
<script src="score-data.js"></script>
<script>
// 로그인 체크
const session = JSON.parse(localStorage.getItem('kpi_session') || 'null');
if (!session || (session.role !== 'admin' && session.role !== 'manager')) {
    location.href = 'login.html';
}

let targetDept = session.role === 'manager' ? session.department : (new URLSearchParams(location.search).get('dept') || '');

document.getElementById('userInfo').textContent = session.role === 'admin' ? '관리자님' : `${session.name}님`;

// Manager는 대시보드, 가중치설정, 사원관리 숨김
if (session.role === 'manager') {
    document.getElementById('nav-home').style.display = 'none';
    document.getElementById('nav-config').style.display = 'none';
    document.getElementById('nav-admin').style.display = 'none';
}

function logout() {
    localStorage.removeItem('kpi_session');
    location.href = 'login.html';
}

let allData = null;
let usersData = [];
let dailyChart = null;

document.addEventListener('DOMContentLoaded', loadData);

// 부서 변경 (admin용)
function changeDept() {
    targetDept = document.getElementById('deptSelect').value;
    renderDashboard();
}

async function loadData() {
    try {
        const [dataRes, usersRes] = await Promise.all([
            fetch('data.json?t=' + Date.now()),
            fetch('users.json?t=' + Date.now())
        ]);
        allData = await dataRes.json();
        usersData = await usersRes.json();
        
        // admin이면 부서 선택 드롭다운 표시
        if (session.role === 'admin') {
            document.getElementById('deptSelectCard').style.display = 'block';
            populateDeptSelect();
        }
        
        renderDashboard();
    } catch (err) {
        console.error(err);
    }
}

// 부서 선택 옵션 채우기
function populateDeptSelect() {
    const depts = [...new Set(usersData.map(u => u.department).filter(d => d && d !== '전체'))];
    depts.sort();
    const select = document.getElementById('deptSelect');
    depts.forEach(d => {
        const opt = document.createElement('option');
        opt.value = d;
        opt.textContent = d;
        if (d === targetDept) opt.selected = true;
        select.appendChild(opt);
    });
}

function renderDashboard() {
    // 부서 기자 필터
    const deptUsers = usersData.filter(u => !targetDept || u.department === targetDept);
    const deptUserNames = new Set(deptUsers.map(u => u.name));
    
    // 부서 기자들의 기사만 필터
    const deptReporters = allData.reporters.filter(r => deptUserNames.has(r.name));
    
    // 통계 계산
    const allNsids = new Set();
    let totalChars = 0;
    deptReporters.forEach(r => {
        r.articles.forEach(a => {
            if (a.nsid) allNsids.add(a.nsid);
            totalChars += a.char_count || 0;
        });
    });
    
    const uniqueArticleCount = allNsids.size;
    const avgChars = uniqueArticleCount > 0 ? Math.round(totalChars / uniqueArticleCount) : 0;
    
    // 총점 계산
    const evals = ScoreDataStore.getEvals();
    let totalScore = 0;
    deptReporters.forEach(r => {
        r.articles.forEach(a => {
            const evalData = {
                page: a.page || 15,
                charCount: a.char_count || 0,
                ...(evals[a.nsid] || {})
            };
            totalScore += calculateArticleScore(evalData).totalScore;
        });
    });
    
    document.getElementById('totalArticles').textContent = uniqueArticleCount.toLocaleString();
    document.getElementById('totalReporters').textContent = deptReporters.length;
    document.getElementById('avgChars').textContent = avgChars.toLocaleString();
    document.getElementById('totalScore').textContent = totalScore.toFixed(1);
    
    renderTopReporters(deptReporters, evals);
    renderDailyChange(deptReporters);
    renderDailyChart(deptReporters);
}

function renderTopReporters(reporters, evals) {
    // 기사수 + 총점 계산
    const reporterStats = reporters.map(r => {
        let score = 0;
        r.articles.forEach(a => {
            const evalData = {
                page: a.page || 15,
                charCount: a.char_count || 0,
                ...(evals[a.nsid] || {})
            };
            score += calculateArticleScore(evalData).totalScore;
        });
        return {
            name: r.name,
            articleCount: r.article_count,
            totalScore: score
        };
    });
    
    // 기사수 기준 정렬
    reporterStats.sort((a, b) => b.articleCount - a.articleCount);
    const top10 = reporterStats.slice(0, 10);
    
    const tbody = document.getElementById('topReporters');
    tbody.innerHTML = top10.map((r, i) => {
        const rankClass = i === 0 ? 'rank-1' : i === 1 ? 'rank-2' : i === 2 ? 'rank-3' : 'rank-other';
        return `
            <tr style="cursor:pointer;" onclick="location.href='reporter.html?name=${encodeURIComponent(r.name)}'">
                <td><span class="rank-badge ${rankClass}">${i + 1}</span></td>
                <td><strong>${r.name}</strong></td>
                <td>${r.articleCount}</td>
                <td>${r.totalScore.toFixed(1)}</td>
            </tr>
        `;
    }).join('');
    
    if (top10.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="text-center py-3 text-muted">데이터가 없습니다</td></tr>';
    }
}

function renderDailyChange(reporters) {
    // 일별 집계
    const dailyArticles = {};
    reporters.forEach(r => {
        r.articles.forEach(a => {
            const date = a.pub_date;
            const nsid = a.nsid || a.url;
            if (date && nsid) {
                if (!dailyArticles[date]) dailyArticles[date] = new Set();
                dailyArticles[date].add(nsid);
            }
        });
    });
    
    const dailyCount = {};
    Object.keys(dailyArticles).forEach(date => {
        dailyCount[date] = dailyArticles[date].size;
    });
    
    // 최근 14일
    const today = new Date();
    const allDates = [];
    for (let i = 0; i < 14; i++) {
        const d = new Date(today);
        d.setDate(d.getDate() - i);
        allDates.push(d.toISOString().slice(0, 10));
    }
    
    const sortedDates = allDates.filter(date => {
        const dayOfWeek = new Date(date).getDay();
        return dayOfWeek === 0 || dailyCount[date] !== undefined;
    }).slice(0, 12);
    
    const tbody = document.getElementById('dailyChange');
    tbody.innerHTML = sortedDates.map((date, i) => {
        const count = dailyCount[date] || 0;
        const dayOfWeek = new Date(date).getDay();
        const isSunday = dayOfWeek === 0;
        
        const prevDate = sortedDates[i + 1];
        const prevCount = prevDate ? (dailyCount[prevDate] || 0) : null;
        
        let diffHtml = '';
        if (prevCount !== null) {
            const diff = count - prevCount;
            if (diff > 0) {
                diffHtml = `<span class="text-success fw-bold"><i class="bi bi-arrow-up"></i> +${diff}</span>`;
            } else if (diff < 0) {
                diffHtml = `<span class="text-danger fw-bold"><i class="bi bi-arrow-down"></i> ${diff}</span>`;
            } else {
                diffHtml = `<span class="text-muted">0</span>`;
            }
        } else {
            diffHtml = `<span class="text-muted">-</span>`;
        }
        
        return `
            <tr${isSunday ? ' class="table-secondary"' : ''}>
                <td>${date.slice(5)}${isSunday ? ' <small class="text-muted">(일)</small>' : ''}</td>
                <td><strong>${count}</strong></td>
                <td>${diffHtml}</td>
            </tr>
        `;
    }).join('');
}

function renderDailyChart(reporters) {
    const dailyArticles = {};
    reporters.forEach(r => {
        r.articles.forEach(a => {
            const date = a.pub_date;
            const nsid = a.nsid || a.url;
            if (date && nsid) {
                if (!dailyArticles[date]) dailyArticles[date] = new Set();
                dailyArticles[date].add(nsid);
            }
        });
    });
    
    const dailyCount = {};
    Object.keys(dailyArticles).forEach(date => {
        dailyCount[date] = dailyArticles[date].size;
    });
    
    const today = new Date();
    const allDates = [];
    for (let i = 13; i >= 0; i--) {
        const d = new Date(today);
        d.setDate(d.getDate() - i);
        allDates.push(d.toISOString().slice(0, 10));
    }
    
    const labels = allDates.map(d => d.slice(5));
    const data = allDates.map(d => dailyCount[d] || 0);
    
    const bgColors = allDates.map(d => {
        const dayOfWeek = new Date(d).getDay();
        return dayOfWeek === 0 ? '#cbd5e0' : '#2c5282';
    });
    
    const ctx = document.getElementById('dailyChart').getContext('2d');
    if (dailyChart) dailyChart.destroy();
    
    dailyChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: '기사수',
                data: data,
                backgroundColor: bgColors,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true } }
        }
    });
}
</script>
</body>
</html>
